{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    // DTOs are populated by class-transformer at runtime, not by constructors.
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}