generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  agent
  viewer

  @@map("user_role")
}

enum TicketStatus {
  open
  pending
  solved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users   User[]
  tickets Ticket[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @db.Uuid @map("org_id")
  name      String
  email     String
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  requestedTickets Ticket[] @relation("TicketRequester")
  assignedTickets  Ticket[] @relation("TicketAssignee")

  @@unique([orgId, email])
  @@map("users")
}

model Ticket {
  id          String         @id @default(uuid(7)) @db.Uuid
  orgId       String         @db.Uuid @map("org_id")
  subject     String
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(normal)
  requesterId String         @db.Uuid @map("requester_id")
  assigneeId  String?        @db.Uuid @map("assignee_id")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  requester User  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tickets")
}
