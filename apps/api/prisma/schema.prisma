generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  agent
  viewer

  @@map("user_role")
}

enum TicketStatus {
  open
  pending
  solved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users   User[]
  tickets Ticket[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  email     String
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  requestedTickets Ticket[] @relation("TicketRequester")
  assignedTickets  Ticket[] @relation("TicketAssignee")

  @@unique([orgId, email])
  @@map("users")
}

model Ticket {
  id          String         @id @default(uuid(7)) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  subject     String
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(normal)
  requesterId String         @map("requester_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  requester User  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt, id], map: "tickets_org_created_idx")
  @@index([orgId, assigneeId, createdAt, id], map: "tickets_org_assignee_active_idx", where: raw("status = ANY (ARRAY['open'::ticket_status, 'pending'::ticket_status])"))
  @@index([orgId, updatedAt, id], map: "tickets_org_updated_idx")
  @@map("tickets")
}
