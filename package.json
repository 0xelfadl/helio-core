{
  "name": "helio-core",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
     "build:shared": "pnpm --filter @helio/shared build",
     "codegen": "pnpm build:shared && pnpm --filter @helio/api db:generate",
     "typecheck": "pnpm codegen && pnpm -r typecheck"
  }
}